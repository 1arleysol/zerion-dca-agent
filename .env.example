# Required — get from dashboard.zerion.io
ZERION_API_KEY=zk_your_key_here

# Wallet created with: zerion wallet create --agent --name dca-agent
WALLET_NAME=dca-agent

# USD to spend per cycle
BUDGET_PER_CYCLE_USD=5

# How often to run in milliseconds (3600000 = 1 hour)
INTERVAL_MS=3600000

# Skip cycle if price dropped more than X% since last cycle
CIRCUIT_BREAKER_DROP_PCT=20

# Swap slippage percentage (default 2%)
SLIPPAGE_PCT=2

# Set to "true" to simulate without real trades
DRY_RUN=false

# Tokens to buy — must sum to 100%
# USDC entries are skipped (already stable)
DCA_TARGETS=[{"symbol":"ETH","token":"ETH","chain":"base","pct":100}]
